# Kết nối Supabase (chỉ dùng phía server, KHÔNG công khai ra frontend)
SUPABASE_URL=https://your-project-id.supabase.co
# Hỗ trợ cả Secret API Key mới (sb_secret_...) lẫn service_role JWT cũ
SUPABASE_SERVICE_ROLE_KEY=sb_secret_thay-bang-secret-api-key-cua-ban

# Mật khẩu dùng chung cho khoảng 2 người quản lý nội dung quy trình
# Có thể dùng ADMIN_PASSWORD hoặc dùng ADMIN_PASSWORD_HASH (định dạng scrypt:<salt>:<hex>)
ADMIN_PASSWORD=thay-bang-mat-khau-manh-cua-ban

# Chuỗi bí mật ngẫu nhiên tối thiểu 32 ký tự để ký cookie phiên đăng nhập quản trị
ADMIN_SESSION_SECRET=thay-bang-chuoi-bi-mat-ngau-nhien-toi-thieu-32-ky-tu
